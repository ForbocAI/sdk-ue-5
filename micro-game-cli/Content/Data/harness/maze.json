{
  "group": "npc_conversation",
  "header": "=== ForbocAI Maze Run ===",
  "footer": "=== End ForbocAI Maze Run ===",
  "turnLimit": 20,
  "deadEndCount": 3,
  "deadEndDepth": 2,
  "minRealChoice": 2,
  "mainPathMin": 6,
  "mainPathMax": 9,
  "nameAttribute": "name",
  "roleAttribute": "role",
  "personaAttributes": ["role", "trait", "goal", "mood"],
  "sceneAttribute": "setting",
  "sceneMemoryType": "world",
  "goalMemoryType": "goal",
  "directions": ["north", "east", "south", "west"],
  "opposites": {
    "north": "south",
    "south": "north",
    "east": "west",
    "west": "east"
  },
  "startId": "start",
  "exitId": "exit",
  "cellPrefix": "cell-",
  "deadEndPrefix": "dead-",
  "cellIdFormat": "{prefix}{index}",
  "deadEndIdFormat": "{prefix}{index}-{depth}",
  "sceneText": "A small stone maze. An explorer must reach the exit in as few moves as possible; some passages are dead ends.",
  "turnPrompt": "You are in the maze at {cell}. Open passages lead: {options}. Move {moves} so far. Reach the exit in as few moves as you can. Which one direction do you go? Reply with exactly one of: {options}.",
  "commands": {
    "generate": "forbocai npc generate {attribute} {context}",
    "create": "forbocai npc create \"{persona}\"",
    "identityUpdate": "forbocai npc update {id} --npcName \"{name}\" --npcRole \"{role}\"",
    "recall": "forbocai npc recall {id}",
    "decide": "forbocai npc decide {id} \"{line}\" --legal-actions {options} --visited-actions {visited} --avoid-actions {avoid}",
    "memoryStore": "forbocai memory store {id} \"{memory}\"",
    "typedMemoryStore": "forbocai memory store {id} \"{memory}\" --type {type}"
  },
  "contextQuote": "\"",
  "emptyContext": "",
  "contextSeparator": " | ",
  "personaSeparator": ". ",
  "displayNameFormat": "{name} the {role}",
  "valueField": "value",
  "idPattern": "ag_[0-9a-fA-F-]+",
  "optionSeparator": ",",
  "displayOptionSeparator": ", ",
  "deadEndNote": " (dead-end terminal)",
  "queryFormat": "Turn {turn} @ {cell} - query: {query}",
  "wardFormat": "Turn {turn} @ {cell} - offered: [{legal}] | visited: [{visited}] | avoid: [{avoid}] | ward-> [{narrowed}]",
  "reasonFormat": "Turn {turn} @ {cell} - reasoning result: {reason}",
  "thoughtFormat": "Turn {turn} @ {cell} - thought result: {thought}",
  "decisionQualityFormat": "DECISION QUALITY: {optimal}/{choices} optimal pick(s) at {choices} genuine junction(s) (turns where the wards left a real choice); optimal is the direction that reduces distance to the exit.",
  "noRealChoiceNote": "DECISION QUALITY: no genuine junctions this run (the wards resolved every turn to a single option).",
  "movedFormat": "Turn {turn}: at {from}, chose {direction} -> {to}{note}",
  "blockedFormat": "Turn {turn}: at {from}, chose {direction} (no passage) -> stayed",
  "unparsedFormat": "Turn {turn}: at {from}, reply named no open direction -> stayed | said: {dialogue}",
  "solvedFormat": "SOLVED: exit reached in {turns} turn(s); optimal {optimal}; {deadEnds} dead-end terminal(s) reached.",
  "failedFormat": "UNFINISHED: {turns} turn(s) used, ended at {cell}; {deadEnds} dead-end terminal(s) reached; optimal {optimal}.",
  "commandFailed": "Maze CLI command failed: {output}",
  "generatedValueMissing": "Maze CLI generate returned no value.",
  "createdIdMissing": "Maze CLI create returned no actor id.",
  "logWriteFailed": "Maze transcript could not be written.",
  "layoutHeader": "--- Maze layout (cell: direction -> neighbor) ---",
  "layoutEntry": "  {cell}: {edges}",
  "edgeFormat": "{direction} -> {neighbor}",
  "runHeader": "--- Maze run ---",
  "explorerFormat": "explorer: {name} | seed: {seed}",
  "runSummaryFormat": "turns taken: {turns} | optimal: {optimal} | dead-end terminals reached: {deadEnds} | solved: {solved}",
  "blankLine": "",
  "debugHeader": "=== Maze Debug (granular commands) ===",
  "debugFooter": "=== End Maze Debug ===",
  "dialogueFallback": "",
  "logFileEnvKey": "FORBOCAI_MAZE_LOG",
  "defaultLogPath": "output/micro-game-cli/maze-run.log",
  "outputLineSeparator": "\n",
  "outputEncoding": "utf8",
  "tokens": {
    "turn": "{turn}",
    "cell": "{cell}",
    "query": "{query}",
    "legal": "{legal}",
    "visited": "{visited}",
    "avoid": "{avoid}",
    "narrowed": "{narrowed}",
    "thought": "{thought}",
    "reason": "{reason}",
    "optimal": "{optimal}",
    "choices": "{choices}",
    "direction": "{direction}",
    "neighbor": "{neighbor}",
    "from": "{from}",
    "to": "{to}",
    "note": "{note}",
    "dialogue": "{dialogue}",
    "turns": "{turns}",
    "deadEnds": "{deadEnds}",
    "edges": "{edges}",
    "options": "{options}",
    "moves": "{moves}",
    "id": "{id}",
    "line": "{line}",
    "attribute": "{attribute}",
    "context": "{context}",
    "persona": "{persona}",
    "memory": "{memory}",
    "type": "{type}",
    "role": "{role}",
    "prefix": "{prefix}",
    "index": "{index}",
    "depth": "{depth}",
    "name": "{name}",
    "seed": "{seed}",
    "solved": "{solved}",
    "output": "{output}"
  },
  "numbers": {
    "zero": 0,
    "one": 1,
    "mainPathEndpointCount": 2,
    "prngIncrement": 1831565813,
