{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forboc.ai/schemas/parity/report-index.schema.json",
  "title": "ForbocAI parity report index",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "generatedBy",
    "sources",
    "summary",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "reportId": {"type": "string"},
    "generatedBy": {"type": "string"},
    "sources": {"$ref": "report-part.schema.json#/$defs/sources"},
    "summary": {"$ref": "report-part.schema.json#/$defs/summary"},
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "summary": {"$ref": "report-part.schema.json#/$defs/summary"}
        }
      }
    }
  }
}
