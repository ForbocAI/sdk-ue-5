    "expected": {"directiveCount":1,"activeId":"hp_1","runs":[{"id":"hp_1","exists":true,"status":1,"npcId":"npc_primary","observation":"A nearby event requires a response","recallQuery":"recent event context","recallLimit":5,"recallThreshold":0.6,"verdictValid":true,"dialogue":"I will respond.","actionType":"INTERACT"}]}
  }
