  {
    "name": "Selectors",
    "actions": [
      {"kind":"Start","id":"sel_1","npcId":"n1","observation":"A"},
      {"kind":"Start","id":"sel_2","npcId":"n2","observation":"B"}
    ],
    "expected": {"directiveCount":2,"activeId":"sel_2","runs":[{"id":"ghost","exists":false},{"id":"sel_1","exists":true,"npcId":"n1"},{"id":"sel_2","exists":true,"npcId":"n2"}]}
