    ],
    "expected": {"directiveCount":1,"activeId":"dir_fail","runs":[{"id":"dir_fail","exists":true,"status":2,"error":"API timeout"}]}
  },
  {
    "name": "ClearForNpc",
    "actions": [
      {"kind":"Start","id":"d1","npcId":"npc_x","observation":"Observation one"},
      {"kind":"Start","id":"d2","npcId":"npc_y","observation":"Observation two"},
      {"kind":"Start","id":"d3","npcId":"npc_x","observation":"Observation three"},
      {"kind":"ClearNpc","npcId":"npc_x"}
