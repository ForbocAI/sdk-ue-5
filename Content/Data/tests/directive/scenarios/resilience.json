[
  {
    "name": "MultipleConcurrent",
    "actions": [
      {
        "kind": 0,
        "id": "d_a",
        "npcId": "npc_1",
        "observation": "obs_a"
      },
      {
        "kind": 0,
        "id": "d_b",
        "npcId": "npc_2",
        "observation": "obs_b"
      },
      {
        "kind": 3,
        "id": "d_a",
        "error": "API timeout"
      }
    ],
    "expected": {
      "directiveCount": 2,
      "activeId": "d_b",
      "runs": [
        {
          "id": "d_a",
          "exists": true,
          "status": 2,
          "error": "API timeout"
        },
        {
          "id": "d_b",
          "exists": true,
          "status": 0
        }
      ]
    }
  },
  {
    "name": "ClearForNpcSelective",
    "actions": [
      {
        "kind": 0,
        "id": "d1",
        "npcId": "npc_target",
        "observation": "obs1"
      },
      {
        "kind": 0,
        "id": "d2",
        "npcId": "npc_keep",
        "observation": "obs2"
      },
      {
        "kind": 0,
        "id": "d3",
        "npcId": "npc_target",
        "observation": "obs3"
      },
      {
        "kind": 4,
        "npcId": "npc_target"
      }
    ],
    "expected": {
      "directiveCount": 1,
      "activeId": "",
      "runs": [
        {
          "id": "d1",
          "exists": false
        },
        {
          "id": "d2",
          "exists": true,
          "npcId": "npc_keep"
        },
        {
          "id": "d3",
          "exists": false
        }
      ]
    }
  },
