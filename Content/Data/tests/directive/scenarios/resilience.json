[
  {
    "name": "MultipleConcurrent",
    "actions": [
      {"kind":"Start","id":"d_a","npcId":"npc_1","observation":"obs_a"},
      {"kind":"Start","id":"d_b","npcId":"npc_2","observation":"obs_b"},
      {"kind":"Fail","id":"d_a","error":"API timeout"}
    ],
    "expected": {"directiveCount":2,"activeId":"d_b","runs":[{"id":"d_a","exists":true,"status":2,"error":"API timeout"},{"id":"d_b","exists":true,"status":0}]}
  },
  {
    "name": "ClearForNpcSelective",
    "actions": [
      {"kind":"Start","id":"d1","npcId":"npc_target","observation":"obs1"},
      {"kind":"Start","id":"d2","npcId":"npc_keep","observation":"obs2"},
      {"kind":"Start","id":"d3","npcId":"npc_target","observation":"obs3"},
      {"kind":"ClearNpc","npcId":"npc_target"}
    ],
    "expected": {"directiveCount":1,"activeId":"","runs":[{"id":"d1","exists":false},{"id":"d2","exists":true,"npcId":"npc_keep"},{"id":"d3","exists":false}]}
  },
  {
    "name": "FailNonExistent",
    "actions": [
      {"kind":"Fail","id":"does_not_exist","error":"phantom error"}
    ],
    "expected": {"directiveCount":0,"activeId":"","runs":[{"id":"does_not_exist","exists":false}]}
  },
  {
    "name": "VerdictNonExistent",
    "actions": [
      {"kind":"Validate","id":"ghost_id","verdictValid":true,"dialogue":"orphan verdict","hasAction":false}
    ],
    "expected": {"directiveCount":0,"activeId":"","runs":[{"id":"ghost_id","exists":false}]}
  },
  {
    "name": "ReceivedNonExistent",
    "actions": [
      {"kind":"Receive","id":"missing_id","query":"lost context","limit":5,"threshold":0.7}
    ],
    "expected": {"directiveCount":0,"activeId":"","runs":[{"id":"missing_id","exists":false}]}
  },
  {
    "name": "DuplicateStart",
    "actions": [
      {"kind":"Start","id":"dup","npcId":"npc1","observation":"First"},
      {"kind":"Start","id":"dup","npcId":"npc2","observation":"Second"}
    ],
    "expected": {"directiveCount":1,"activeId":"dup","runs":[{"id":"dup","exists":true,"status":0,"npcId":"npc2","observation":"Second"}]}
  },
  {
    "name": "FailThenRestart",
    "actions": [
      {"kind":"Start","id":"r1","npcId":"npc_a","observation":"Try one"},
      {"kind":"Fail","id":"r1","error":"Timeout"},
      {"kind":"Start","id":"r1","npcId":"npc_a","observation":"Try two"}
    ],
    "expected": {"directiveCount":1,"activeId":"r1","runs":[{"id":"r1","exists":true,"status":0,"observation":"Try two","error":""}]}
  }
]
