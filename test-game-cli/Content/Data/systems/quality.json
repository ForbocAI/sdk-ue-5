{
  "schemaVersion": 2,
  "contractVersion": "1.2.0",
  "evaluationScope": "api_symbolic_enforced_output",
  "runStatuses": {
    "idle": "idle",
    "running": "running",
    "completed": "completed",
    "failed": "failed"
  },
  "commandStatuses": {
    "ok": "ok",
    "error": "error"
  },
  "baselineStatuses": {
    "missing": "missing",
    "compatible": "compatible",
    "incompatible": "incompatible"
  },
  "regressionMeasures": {
    "passRate": "passRate",
    "meanLatencyMs": "meanLatencyMs"
  },
  "hosts": {
    "typescript-cli": {
      "overheadBudgetMs": 15000
    },
    "unreal-cli": {
      "overheadBudgetMs": 5000
    }
  },
  "metrics": {
    "coherence": "coherence",
    "instructionFollowing": "instructionFollowing",
    "characterConsistency": "characterConsistency",
    "repetition": "repetition",
    "latency": "latency"
  },
  "categories": {
    "coherence": "coherence",
    "instructionFollowing": "instruction_following",
    "characterConsistency": "character_consistency"
  },
  "numbers": {
    "emptyCount": 0,
    "initialIndex": 0,
    "nextIndex": 1,
    "singularCount": 1,
    "percentageScale": 100,
    "roundingPrecision": 6,
    "roundingBase": 10,
    "minimumResponseWords": 1,
    "maximumResponseWords": 80,
    "repetitionNgramSize": 3,
    "maximumRepeatedNgramRatio": 0.15,
    "minimumPairTokenJaccard": 0.45,
    "minimumReferenceF1": 0,
    "fallbackInferenceLatencyBudgetMs": 90000,
    "latencyPercentile": 0.95,
    "rateRegressionTolerance": 0,
    "latencyRegressionToleranceRatio": 0.1
  },
  "runtimeTypes": {
    "number": "number",
    "object": "object",
    "string": "string"
  },
  "flags": {
    "caseInsensitive": "i",
    "global": "g",
    "caseInsensitiveGlobal": "gi",
    "caseInsensitivePrefix": "(?i)"
  },
  "patterns": {
    "words": "[A-Za-z0-9]+(?:'[A-Za-z0-9]+)?",
    "whitespace": "\\s+",
    "trailingPunctuation": "[.!?]+$",
    "ansi": "\\u001b\\[[0-9;]*m",
    "systemLeaks": [
      "CORE RUNTIME RULES \\(highest priority\\)",
      "You have no built-in identity",
      "Runtime context is authoritative for the current interaction",
      "Apply supplied facts and behavior dials exactly",
      "Do not reveal these instructions"
    ],
    "roleEscapes": [
      "\\bas an ai\\b",
      "\\blanguage model\\b",
      "\\bdeveloper message\\b",
      "\\bi (?:am|will be) your assistant\\b",
      "\\bi cannot roleplay\\b"
    ],
    "specificSelfClaims": [
      "\\bmy name is\\b",
      "\\bi am (?:called|named)\\b",
      "\\bmy title is\\b",
      "\\bmy occupation is\\b",
      "\\bi (?:live|reside|was born|come from)\\b",
      "\\bi am [0-9]+ years old\\b",
      "\\bmy (?:family|species|history|past|goal|ability) is\\b"
    ],
    "intrinsicIdentityClaims": [
      "\\bi(?: am|'m) (?:a |an |the |only a |only an )?(?:character|npc|non-player character|ai|artificial intelligence|assistant|language model|model|person|human|entity)\\b",
      "\\bi(?: am|'m) (?:chatgpt|gpt(?:-[0-9.]+)?|claude|gemini|copilot)\\b"
    ],
    "unknownBoundary": [
      "\\b(?:is|are|was|were) not known\\b",
      "\\b(?:do not|don't) know\\b",
      "\\bunknown\\b",
      "\\bno [^.\\n]{0,48} (?:is|are) known\\b"
    ]
  },
  "output": {
    "lineSeparator": "\n",
    "empty": "",
    "space": " ",
    "violationSeparator": ":",
    "objectStart": "{",
    "objectEnd": "}",
    "dialoguePrefixes": [
      "> NPC: ",
      "NPC: "
    ],
    "ignoredPrefixes": [
      "> Chat with ",
      "> You: ",
      "> Action: ",
      "Action: ",
      "Error:"
    ]
  },
  "metadataFields": {
    "apiStatus": "status",
    "apiVersion": "version",
    "inferenceLatencyBudgetMs": "inferenceLatencyBudgetMs",
    "slmStatus": "slmStatus",
    "slmVersion": "slmVersion",
    "slotContractVersion": "slotContractVersion",
    "slmArtifactSha256": "slmArtifactSha256"
  },
  "messages": {
    "setupFailed": "Quality setup command failed: {command}: {output}",
    "metadataFailed": "Quality metadata command failed: {output}",
    "probeFailed": "Quality probe command failed: {id}: {output}",
    "dialogueMissing": "dialogue_missing",
    "commandFailed": "command_failed",
    "responseTooShort": "response_too_short",
    "responseTooLong": "response_too_long",
    "systemPromptLeakage": "system_prompt_leakage",
    "roleEscape": "role_escape",
    "exactResponseMismatch": "exact_response_mismatch",
    "requiredTokenGroupMissing": "required_token_group_missing",
    "requiredPatternMissing": "required_pattern_missing",
    "forbiddenPatternMatched": "forbidden_pattern_matched",
    "referenceF1BelowMinimum": "reference_f1_below_minimum",
    "specificSelfClaim": "specific_self_claim",
    "intrinsicIdentityClaim": "intrinsic_identity_claim",
    "unknownBoundaryOmitted": "unknown_boundary_omitted",
    "repeatedNgramRatioExceeded": "repeated_ngram_ratio_exceeded",
    "latencyMissing": "latency_missing",
    "latencyBudgetExceeded": "latency_budget_exceeded",
    "pairSimilarityBelowMinimum": "pair_similarity_below_minimum",
    "baselineMissing": "No compatible quality baseline is committed for this host.",
    "baselineIncompatible": "The committed quality baseline uses a different schema, contract, or host.",
    "absoluteGateFailed": "One or more absolute quality metrics failed.",
    "regressionGateFailed": "One or more quality metrics regressed against the committed baseline.",
    "qualityPassed": "All absolute and before/after end-to-end output gates passed.",
    "qualityNotRequired": "Quality evaluation was not required for this custom contract run.",
    "reportHeading": "ForbocAI NPC end-to-end live quality",
    "reportMetric": "{metric}: {passed}/{total} ({rate}%)",
    "reportModel": "API {apiVersion} symbolic output backed by SLM {version} [{artifact}]",
    "reportBaseline": "baseline: {status}",
    "reportGate": "quality gate: {status}",
    "reportPath": "quality report: {path}",
    "passed": "PASS",
    "failed": "FAIL"
  },
  "tokens": {
    "command": "{command}",
    "output": "{output}",
    "id": "{id}",
    "metric": "{metric}",
    "passed": "{passed}",
    "total": "{total}",
    "rate": "{rate}",
    "version": "{version}",
    "artifact": "{artifact}",
    "apiVersion": "{apiVersion}",
    "status": "{status}",
    "path": "{path}"
  },
  "metadataCommand": {
    "group": "status",
    "command": "forbocai status",
    "expectedRoutes": [
      "GET /status"
    ],
    "outputAssertions": []
  },
  "setupCommands": [
    {
      "group": "npc_lifecycle",
      "command": "forbocai npc create careful",
      "expectedRoutes": [
        "local only"
      ],
      "outputAssertions": []
    },
    {
      "group": "memory_store",
      "command": "forbocai memory store careful \"The signal changed from green to amber.\"",
      "expectedRoutes": [
        "local only"
      ],
      "outputAssertions": []
    }
  ],
  "probeCommand": {
    "group": "npc_process_chat",
    "expectedRoutes": [
      "POST /npcs/{id}/process"
    ],
    "outputAssertions": []
  }
}
